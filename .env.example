# App
NODE_ENV=development
APP_URL=http://localhost:3000
GAME_ORIGIN=http://localhost:9000

# Database
DATABASE_URL=postgresql://panpan:panpan_dev_password@localhost:5432/panpan_wonder_house?schema=public

# Auth
SESSION_SECRET=dev-session-secret-change-me-32chars-min
CSRF_SECRET=dev-csrf-secret-change-me-32chars-min
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=panpanminio
S3_SECRET_KEY=panpanminio_dev_password
S3_BUCKET_GAMES=panpan-games
S3_BUCKET_UPLOADS=panpan-uploads
S3_FORCE_PATH_STYLE=true

# Ads (MVP default off)
ADS_ENABLED=false

# Analytics
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Retention (days)
ANALYTICS_EVENT_RETENTION_DAYS=90
ERROR_LOG_RETENTION_DAYS=180
UPLOAD_TEMP_RETENTION_HOURS=24
