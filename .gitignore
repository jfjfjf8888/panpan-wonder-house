# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# local-only secrets (never push)
.local/

# local runtime data (MinIO, etc.)
.data/

# test artifacts
/playwright-report
/test-results
/examples/dist

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
