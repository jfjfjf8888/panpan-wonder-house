generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum GameStatus {
  DRAFT
  VALIDATING
  INVALID
  READY
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
  WARNING
}

enum UploadJobStatus {
  CREATED
  UPLOADING
  UPLOADED
  VALIDATING
  VALIDATED
  INVALID
  PREVIEW_READY
  SAVED
  FAILED
  EXPIRED
}

model Admin {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String         @map("password_hash")
  status       AdminStatus    @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]
  uploadJobs   UploadJob[]
  auditLogs    AuditLog[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  tokenHash String   @unique @map("token_hash")
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model Game {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  shortDescription String              @map("short_description")
  description      String              @default("")
  coverUrl         String?             @map("cover_url")
  iconUrl          String?             @map("icon_url")
  status           GameStatus          @default(DRAFT)
  currentVersionId String?             @unique @map("current_version_id")
  featured         Boolean             @default(false)
  sortOrder        Int                 @default(0) @map("sort_order")
  heatScore        Float               @default(0) @map("heat_score")
  publishedAt      DateTime?           @map("published_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  versions         GameVersion[]       @relation("GameVersions")
  currentVersion   GameVersion?        @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  tagRelations     GameTagRelation[]
  analyticsEvents  AnalyticsEvent[]
  dailyStats       DailyGameStat[]

  @@index([status])
  @@index([featured])
  @@map("games")
}

model GameVersion {
  id                    String           @id @default(cuid())
  gameId                String           @map("game_id")
  version               String
  manifestJson          Json             @map("manifest_json")
  entryUrl              String           @map("entry_url")
  packageUrl            String           @map("package_url")
  packageSha256         String           @map("package_sha256")
  compressedSize        Int              @map("compressed_size")
  uncompressedSize      Int              @map("uncompressed_size")
  validationStatus      ValidationStatus @default(PENDING) @map("validation_status")
  validationReportJson  Json?            @map("validation_report_json")
  createdAt             DateTime         @default(now()) @map("created_at")
  publishedAt           DateTime?        @map("published_at")
  game                  Game             @relation("GameVersions", fields: [gameId], references: [id], onDelete: Cascade)
  currentFor            Game?            @relation("CurrentVersion")
  analyticsEvents       AnalyticsEvent[]

  @@unique([gameId, version])
  @@index([gameId])
  @@map("game_versions")
}

model GameTag {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  relations GameTagRelation[]

  @@map("game_tags")
}

model GameTagRelation {
  gameId String  @map("game_id")
  tagId  String  @map("tag_id")
  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    GameTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@map("game_tag_relations")
}

model AnalyticsEvent {
  id              String       @id @default(cuid())
  eventType       String       @map("event_type")
  gameId          String?      @map("game_id")
  gameVersionId   String?      @map("game_version_id")
  visitorIdHash   String       @map("visitor_id_hash")
  sessionId       String       @map("session_id")
  path            String
  deviceType      String?      @map("device_type")
  browser         String?
  os              String?
  referrer        String?
  propertiesJson  Json?        @map("properties_json")
  createdAt       DateTime     @default(now()) @map("created_at")
  game            Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameVersion     GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([gameId, createdAt])
  @@index([visitorIdHash, createdAt])
  @@map("analytics_events")
}

model DailyGameStat {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  gameId          String   @map("game_id")
  pageViews       Int      @default(0) @map("page_views")
  uniqueVisitors  Int      @default(0) @map("unique_visitors")
  gameOpens       Int      @default(0) @map("game_opens")
  gameStarts      Int      @default(0) @map("game_starts")
  gameEnds        Int      @default(0) @map("game_ends")
  averageDuration Float    @default(0) @map("average_duration")
  completionRate  Float    @default(0) @map("completion_rate")
  repeatRate      Float    @default(0) @map("repeat_rate")
  errorCount      Int      @default(0) @map("error_count")
  heatScore       Float    @default(0) @map("heat_score")
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([date, gameId])
  @@map("daily_game_stats")
}

model DailySiteStat {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  pageViews       Int      @default(0) @map("page_views")
  uniqueVisitors  Int      @default(0) @map("unique_visitors")
  gameOpens       Int      @default(0) @map("game_opens")
  averageDuration Float    @default(0) @map("average_duration")
  mobileVisitors  Int      @default(0) @map("mobile_visitors")
  desktopVisitors Int      @default(0) @map("desktop_visitors")
  tabletVisitors  Int      @default(0) @map("tablet_visitors")

  @@map("daily_site_stats")
}

model UploadJob {
  id                   String          @id @default(cuid())
  adminId              String          @map("admin_id")
  originalFilename     String          @map("original_filename")
  storageKey           String?         @map("storage_key")
  status               UploadJobStatus @default(CREATED)
  progress             Int             @default(0)
  validationReportJson Json?           @map("validation_report_json")
  packageSha256        String?         @map("package_sha256")
  compressedSize       Int?            @map("compressed_size")
  targetGameId         String?         @map("target_game_id")
  mode                 String          @default("create")
  expiresAt            DateTime        @map("expires_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  admin                Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([status])
  @@map("upload_jobs")
}

model AdConfig {
  id              String   @id @default(cuid())
  globalEnabled   Boolean  @default(false) @map("global_enabled")
  siteAdsEnabled  Boolean  @default(false) @map("site_ads_enabled")
  gameAdsEnabled  Boolean  @default(false) @map("game_ads_enabled")
  provider        String?
  configJson      Json?    @map("config_json")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ad_config")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detailJson Json?    @map("detail_json")
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}
